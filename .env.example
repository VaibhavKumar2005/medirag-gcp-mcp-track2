# ================================================================
# MediRAG — Environment Variables
# Track 2 · GCP · Gen AI Academy APAC Edition
# ================================================================
#
# Setup:
#   cp .env.example .env
#   Fill in DJANGO_SECRET_KEY and GOOGLE_API_KEY
#   docker compose up --build
#
# Security model:
#   Local dev  → HashiCorp Vault KV at secret/myapp
#   Cloud Run  → GCP Secret Manager (Workload Identity — no keys in env)
#   API keys are NEVER stored here — they live in the secret backend
#
# ================================================================

# ── Deployment mode ──────────────────────────────────────────────
# "local"  → HashiCorp Vault + Docker Compose + local PostgreSQL
# "cloud"  → GCP Secret Manager + Cloud Run + Cloud SQL
DEPLOY_MODE=local

# ── Django core ──────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_secrets_module
DEBUG=True

# ── GCP configuration ────────────────────────────────────────────
# Required in cloud mode for GCP Secret Manager routing in rag_logic.py
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Model overrides (optional — defaults shown)
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# ── API keys (local dev only — use Vault/Secret Manager in prod) ─
# In cloud mode these are retrieved from GCP Secret Manager automatically.
# Set here ONLY for local development without Vault running.
GOOGLE_API_KEY=AIza...your-google-api-key
GROQ_API_KEY=gsk_...your-groq-api-key-optional

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=rag-db
POSTGRES_DB=medirag_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_PORT=5432

# ── Redis (Celery broker) ────────────────────────────────────────
REDIS_URL=redis://rag-redis:6379/0

# ── HashiCorp Vault (local dev) ──────────────────────────────────
# Only needed when DEPLOY_MODE=local. Skip for Cloud Run.
VAULT_ADDR=http://rag-vault:8200
VAULT_TOKEN=CHANGE_ME_vault_root_token

# ── Demo mode ────────────────────────────────────────────────────
# Enables GET /api/demo/token/ for judge access without creating an account.
# Set to False in real production.
DEMO_MODE=True
DEMO_USER_EMAIL=demo@medirag.dev
DEMO_USER_PASSWORD=MediRAG-Demo-2025!

# ── Frontend ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Observability ────────────────────────────────────────────────
# Cloud Run injects these automatically; set for local dev
CLOUDRUN_SERVICE_URL=

# ── Document encryption (optional hardening) ────────────────────
DOCUMENT_ENCRYPTION_SECRET=CHANGE_ME_32_char_minimum_secret_key
